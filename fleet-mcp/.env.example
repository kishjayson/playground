# Fleet MCP source ref to build.
# Use main while testing; pin a tag or commit once satisfied.
FLEET_MCP_REF=main

# OpenAI Secure MCP Tunnel client version.
TUNNEL_CLIENT_VERSION=v0.0.10

# OpenAI Secure MCP Tunnel runtime configuration.
# CONTROL_PLANE_API_KEY should be a runtime API key with Tunnels Read + Use.
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=

# Existing Fleet instance reachable from this container over the tailnet.
FLEET_BASE_URL=https://fleet.tail2bebc3.ts.net

# Fleet API-only user token.
FLEET_API_KEY=

# Fleet MCP requires this at startup even in stdio mode.
# It is not used as the ChatGPT/tunnel authentication mechanism.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Separate Tailscale identity for this deployment.
TS_AUTHKEY=
TS_HOSTNAME=fleet-mcp

# Optional
TAILSCALE_VERSION=latest
LOG_LEVEL=info
