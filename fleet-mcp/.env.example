# Fleet MCP source ref to build.
# Use main while testing; pin a tag or commit once satisfied.
FLEET_MCP_REF=main

# Existing Fleet instance.
FLEET_BASE_URL=https://fleet.tail2bebc3.ts.net

# Token belonging to a Fleet API-only user.
# Observer covers read tools; observer-plus is required for live queries.
FLEET_API_KEY=

# Bearer token used by MCP clients.
# Minimum 32 characters. Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Separate Tailscale identity for Fleet MCP.
TS_AUTHKEY=
TS_HOSTNAME=fleet-mcp

# Optional
TAILSCALE_VERSION=latest
LOG_LEVEL=info
